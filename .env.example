# Admin authentication is disabled when the password hash is blank.
VOYAGEDECK_ADMIN_PASSWORD_HASH=
# Use 1 only for loopback browser testing over HTTP.
VOYAGEDECK_INSECURE_COOKIE=0
VOYAGEDECK_DB_PATH=data/voyagedeck.sqlite3
# Select mock or openai_compatible. Set the allowed HTTPS base URL on the server.
VOYAGEDECK_PROVIDER_MODE=mock
VOYAGEDECK_PROVIDER_ENDPOINT=
VOYAGEDECK_PROVIDER_MODEL=mock-v1
VOYAGEDECK_PROVIDER_API_KEY=
